# 后端生产环境变量模板
#
# 用法：复制到 /opt/mirror/shared/backend.env，填真实值，然后
#   chown mirror:mirror /opt/mirror/shared/backend.env
#   chmod 600 /opt/mirror/shared/backend.env
#
# ！这个文件里有密钥，绝对不要提交进 git（模板本身没有真实值，可以进）。

# ---- 数据源（application-prod.yml 读这些变量名）----
DB_URL=jdbc:postgresql://127.0.0.1:5432/mu_mirror
DB_USERNAME=mirror
DB_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- JWT（必须显式设置：prod 里默认是空串）----
# 生成：openssl rand -base64 48
JWT_SECRET=

# ---- 运行 profile（Spring Boot 自动读这个环境变量，无需命令行参数）----
SPRING_PROFILES_ACTIVE=prod
