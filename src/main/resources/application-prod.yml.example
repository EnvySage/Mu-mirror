# ==================== 生产环境配置示例 ====================
# 复制此文件为 application-prod.yml 并填入真实配置
# 注意：application-prod.yml 已被 gitignore，不会提交到仓库

spring:
  # 数据源配置
  datasource:
    url: jdbc:postgresql://your-db-host:5432/mirror_prod?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: your_db_username
    password: your_db_password

    # Druid 监控页面（生产环境建议关闭）
    druid:
      stat-view-servlet:
        enabled: false

  # Redis 配置
  data:
    redis:
      host: your-redis-host
      port: 6379
      password: your_redis_password
      database: 0
      timeout: 10000
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 2
          max-wait: -1

# JWT 配置（必须修改为安全的密钥）
jwt:
  secret: your-very-secure-jwt-secret-key-at-least-256-bits
  expiration: 86400000  # 24小时

# 日志配置
logging:
  level:
    root: WARN
    org.xianshen.mumirrorb: INFO
    org.springframework.security: WARN
  pattern:
    dateformat: yyyy-MM-dd HH:mm:ss.SSS
  file:
    name: ./logs/mirror.log
